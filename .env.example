# Optional overrides. Copy to .env and export, or set them in your host/PM2 env.
# Nothing here is required - index.js falls back to the built-in defaults.

# who gets the gift
TARGET_ID=dc6c3aaafa38471499c9

# naira per gift, and how many accounts to run
AMOUNT=1000000
COUNT=1

# accounts at once - leave at 1, see README for why
CONCURRENCY=1

# transfer note (there is a minimum length)
NOTE=closed-loop test

BASE_URL=https://lagoslife.app

# randomise body / hair / outfit / skin tone per account
RANDOMISE_LOOK=true

# save a screenshot of every onboarding screen
# SHOTS=true

# only if you want parallel runs and do not need the game to draw
# LOW_CPU=true

# point this at a Chrome/Chromium binary you already have.
# leave it unset to use the bundled @sparticuz/chromium build.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium